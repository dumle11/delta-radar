<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View android:id="@+id/menuBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:padding="12dp"
        android:background="@drawable/bg_overlay_menu"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delta Radar"
                android:textColor="#4fd08a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_danger"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView android:id="@+id/tabGeneral"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="General" android:textSize="13sp" android:textColor="#5c6b78"
                android:gravity="center" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/tabVisual"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="Visual" android:textSize="13sp" android:textColor="#5c6b78"
                android:gravity="center" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/tabAim"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="Aim" android:textSize="13sp" android:textColor="#5c6b78"
                android:gravity="center" android:clickable="true" android:focusable="true" />

            <TextView android:id="@+id/tabLogs"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="Logs" android:textSize="13sp" android:textColor="#5c6b78"
                android:gravity="center" android:clickable="true" android:focusable="true" />
        </LinearLayout>

        <!-- Tab content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- General tab -->
            <ScrollView android:id="@+id/generalScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="#0a0e12">

                    <!-- Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STATUS"
                            android:textColor="#4fd08a"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="6dp" />

                        <TextView android:id="@+id/statusState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#4fd08a"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="Idle"
                            android:layout_marginBottom="4dp" />

                        <TextView android:id="@+id/statusDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#5c6b78"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:text="Entities: 0" />
                    </LinearLayout>

                    <!-- Hide bubble -->
                    <LinearLayout android:id="@+id/toggleHideBubble"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hide bubble (keep touch)"
                            android:textColor="#c8d6e0"
                            android:textSize="13sp" />

                        <TextView android:id="@+id/toggleHideBubbleState"
                            android:layout_width="48dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="OFF"
                            android:textColor="#e5534b"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="#1E2940" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Visual tab -->
            <ScrollView android:id="@+id/visualScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="#0a0e12">

                    <!-- Enemy lines toggle -->
                    <LinearLayout android:id="@+id/toggleEnemyLines"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Draw enemy lines"
                            android:textColor="#c8d6e0" android:textSize="13sp" />
                        <TextView android:id="@+id/toggleEnemyLinesState"
                            android:layout_width="48dp" android:layout_height="24dp"
                            android:gravity="center" android:text="OFF"
                            android:textColor="#e5534b" android:textSize="11sp"
                            android:textStyle="bold" android:background="#1E2940" />
                    </LinearLayout>
                    <TextView android:id="@+id/enemyLinesDetails"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Lines from your player to enemies"
                        android:textColor="#5c6b78" android:textSize="10sp"
                        android:paddingLeft="4dp" android:layout_marginBottom="8dp" />

                    <!-- Enemy labels toggle -->
                    <LinearLayout android:id="@+id/toggleEnemyLabels"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Show names and distance"
                            android:textColor="#c8d6e0" android:textSize="13sp" />
                        <TextView android:id="@+id/toggleEnemyLabelsState"
                            android:layout_width="48dp" android:layout_height="24dp"
                            android:gravity="center" android:text="OFF"
                            android:textColor="#e5534b" android:textSize="11sp"
                            android:textStyle="bold" android:background="#1E2940" />
                    </LinearLayout>
                    <TextView android:id="@+id/enemyLabelsDetails"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Name and distance labels" android:textColor="#5c6b78"
                        android:textSize="10sp" android:paddingLeft="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Show Players toggle -->
                    <LinearLayout android:id="@+id/toggleShowPlayers"
                        android:layout_width="match_parent" android:layout_height="42dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingLeft="4dp" android:paddingRight="4dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Show players/bots"
                            android:textColor="#c8d6e0" android:textSize="13sp" />
                        <TextView android:id="@+id/toggleShowPlayersState"
                            android:layout_width="48dp" android:layout_height="24dp"
                            android:gravity="center" android:text="OFF"
                            android:textColor="#e5534b" android:textSize="11sp"
                            android:textStyle="bold" android:background="#1E2940" />
                    </LinearLayout>

                    <!-- Show Teammates toggle -->
                    <LinearLayout android:id="@+id/toggleShowTeammates"
                        android:layout_width="match_parent" android:layout_height="42dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingLeft="4dp" android:paddingRight="4dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Show teammates"
                            android:textColor="#c8d6e0" android:textSize="13sp" />
                        <TextView android:id="@+id/toggleShowTeammatesState"
                            android:layout_width="48dp" android:layout_height="24dp"
                            android:gravity="center" android:text="OFF"
                            android:textColor="#e5534b" android:textSize="11sp"
                            android:textStyle="bold" android:background="#1E2940" />
                    </LinearLayout>

                    <!-- Show Loot toggle -->
                    <LinearLayout android:id="@+id/toggleShowLoot"
                        android:layout_width="match_parent" android:layout_height="42dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingLeft="4dp" android:paddingRight="4dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Show loot/interactables"
                            android:textColor="#c8d6e0" android:textSize="13sp" />
                        <TextView android:id="@+id/toggleShowLootState"
                            android:layout_width="48dp" android:layout_height="24dp"
                            android:gravity="center" android:text="OFF"
                            android:textColor="#e5534b" android:textSize="11sp"
                            android:textStyle="bold" android:background="#1E2940" />
                    </LinearLayout>

                    <!-- Render distance -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Render distance"
                                android:textColor="#c8d6e0" android:textSize="13sp" />
                            <TextView android:id="@+id/renderDistValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="500m" android:textColor="#4fd08a"
                                android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar android:id="@+id/renderDistSeek"
                            android:layout_width="match_parent" android:layout_height="36dp"
                            android:max="1000" android:progress="500" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Line / box thickness"
                                android:textColor="#c8d6e0" android:textSize="13sp" />
                            <TextView android:id="@+id/lineThicknessValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="75%" android:textColor="#4fd08a"
                                android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar android:id="@+id/lineThicknessSeek"
                            android:layout_width="match_parent" android:layout_height="36dp"
                            android:max="275" android:progress="50" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E2940" android:layout_marginBottom="8dp" />

                    <!-- PLAYERS section header -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAYERS" android:textColor="#e5534b"
                        android:textSize="10sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:paddingLeft="4dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout android:id="@+id/playerFeatureContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp" />

                    <!-- Player draw mode -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/playerModeOff"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Off" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerModeLines"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Lines" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerModeBoxes"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Boxes" android:textSize="10sp"
                            android:textColor="#0a0e12" android:background="#e5534b"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerModeSkeleton"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Skeleton" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <!-- Player color presets -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/playerColorRed"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Red" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#e5534b"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerColorCyan"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Cyan" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#46D9FF"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerColorYellow"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Yellow" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#FFE066"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerColorWhite"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="White" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#FFFFFF"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/playerColorPurple"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Purple" android:textSize="9sp"
                            android:textColor="#FFFFFF" android:background="#9B59B6"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E2940" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TEAMMATES / FRIENDLIES" android:textColor="#4fd08a"
                        android:textSize="10sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:paddingLeft="4dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout android:id="@+id/teammateFeatureContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/teammateModeOff"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Off"
                            android:textSize="10sp" android:textColor="#c8d6e0" android:background="#1E2940" />
                        <TextView android:id="@+id/teammateModeLines"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Lines"
                            android:textSize="10sp" android:textColor="#c8d6e0" android:background="#1E2940" />
                        <TextView android:id="@+id/teammateModeBoxes"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Boxes"
                            android:textSize="10sp" android:textColor="#0a0e12" android:background="#4fd08a" />
                        <TextView android:id="@+id/teammateModeSkeleton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Skeleton"
                            android:textSize="10sp" android:textColor="#c8d6e0" android:background="#1E2940" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/teammateColorGreen"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Green"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#4fd08a" />
                        <TextView android:id="@+id/teammateColorCyan"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Cyan"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#46D9FF" />
                        <TextView android:id="@+id/teammateColorYellow"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Yellow"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#FFE066" />
                        <TextView android:id="@+id/teammateColorWhite"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="White"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#FFFFFF" />
                        <TextView android:id="@+id/teammateColorPurple"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Purple"
                            android:textSize="9sp" android:textColor="#FFFFFF" android:background="#9B59B6" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E2940" android:layout_marginBottom="8dp" />

                    <!-- BOTS section header -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BOTS" android:textColor="#46D9FF"
                        android:textSize="10sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:paddingLeft="4dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout android:id="@+id/botFeatureContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp" />

                    <!-- Bot draw mode -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/botModeOff"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Off" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botModeLines"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Lines" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botModeBoxes"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Boxes" android:textSize="10sp"
                            android:textColor="#0a0e12" android:background="#46D9FF"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botModeSkeleton"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Skeleton" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <!-- Bot color presets -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/botColorCyan"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Cyan" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#46D9FF"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botColorGreen"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Green" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#4fd08a"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botColorYellow"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Yellow" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#FFE066"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botColorRed"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Red" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#e5534b"
                            android:clickable="true" android:focusable="true" />
                        <TextView android:id="@+id/botColorOrange"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Orange" android:textSize="9sp"
                            android:textColor="#0a0e12" android:background="#FF8C42"
                            android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E2940" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOOT / INTERACTABLES" android:textColor="#4fd08a"
                        android:textSize="10sp" android:textStyle="bold"
                        android:letterSpacing="0.1" android:paddingLeft="4dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout android:id="@+id/lootFeatureContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/lootModeOff"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Off" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940" />
                        <TextView android:id="@+id/lootModeLines"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Lines" android:textSize="10sp"
                            android:textColor="#c8d6e0" android:background="#1E2940" />
                        <TextView android:id="@+id/lootModeBoxes"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:layout_margin="1dp"
                            android:gravity="center" android:text="Boxes" android:textSize="10sp"
                            android:textColor="#0a0e12" android:background="#4fd08a" />
                        <TextView android:id="@+id/lootModeMarker"
                            android:layout_width="0dp" android:layout_weight="0"
                            android:layout_height="match_parent" android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
                        android:orientation="horizontal" android:paddingLeft="4dp"
                        android:paddingRight="4dp" android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/lootColorGreen"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Green"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#4fd08a" />
                        <TextView android:id="@+id/lootColorCyan"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Cyan"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#46D9FF" />
                        <TextView android:id="@+id/lootColorYellow"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Yellow"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#FFE066" />
                        <TextView android:id="@+id/lootColorRed"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Red"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#e5534b" />
                        <TextView android:id="@+id/lootColorOrange"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_margin="1dp" android:gravity="center" android:text="Orange"
                            android:textSize="9sp" android:textColor="#0a0e12" android:background="#FF8C42" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView android:id="@+id/aimScroll"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:background="#0a0e12">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="BODY AIM" android:textColor="#4fd08a" android:textSize="11sp"
                        android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <Switch android:id="@+id/aimEnabled" android:layout_width="match_parent"
                        android:layout_height="48dp" android:text="Automatic aim · no hold button" android:textColor="#c8d6e0" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Enable aim to track a verified enemy inside the circle. No button setup is needed for aiming."
                        android:textColor="#8a9aaa" android:textSize="12sp" />
                    <Switch android:id="@+id/aimCircle" android:layout_width="match_parent"
                        android:layout_height="48dp" android:text="Show FOV circle" android:textColor="#c8d6e0" />
                    <TextView android:id="@+id/aimFovLabel" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#c8d6e0" android:text="FOV radius: 15%" />
                    <SeekBar android:id="@+id/aimFovSlider" android:layout_width="match_parent"
                        android:layout_height="48dp" android:max="40" android:contentDescription="Aim FOV radius" />
                    <TextView android:id="@+id/aimStrengthLabel" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#c8d6e0" android:text="Aim strength: 30%" />
                    <SeekBar android:id="@+id/aimStrengthSlider" android:layout_width="match_parent"
                        android:layout_height="48dp" android:max="50" android:contentDescription="Aim assistance strength" />
                    <Switch android:id="@+id/aimAutoShoot" android:layout_width="match_parent"
                        android:layout_height="48dp" android:text="Auto shoot on crosshair" android:textColor="#c8d6e0" />
                    <TextView android:id="@+id/aimStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#4fd08a"
                        android:text="Aim disabled" android:layout_marginBottom="14dp" />
                    <TextView android:id="@+id/aimSetLook" android:layout_width="match_parent"
                        android:layout_height="48dp" android:gravity="center" android:text="Customize camera drag area (optional)"
                        android:textColor="#c8d6e0" android:background="@drawable/bg_card"
                        android:clickable="true" android:focusable="true" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/aimDefaultLook" android:layout_width="match_parent"
                        android:layout_height="48dp" android:gravity="center" android:text="Use default camera drag area"
                        android:textColor="#c8d6e0" android:background="@drawable/bg_card"
                        android:clickable="true" android:focusable="true" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/aimSetFire" android:layout_width="match_parent"
                        android:layout_height="48dp" android:gravity="center" android:text="Set fire button"
                        android:textColor="#c8d6e0" android:background="@drawable/bg_card"
                        android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/aimCalibration" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#8a9aaa"
                        android:text="Set your fire button before enabling auto shoot."
                        android:layout_marginTop="10dp" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Targets the torso only when the reader reports a plaintext position, known positive health and an on-screen rendered mesh. Encrypted or unverified targets are skipped. Aim stops if camera feedback does not improve. Rendering is not a guarantee of line of sight."
                        android:textColor="#8a9aaa" android:textSize="12sp" android:layout_marginTop="12dp" />
                </LinearLayout>
            </ScrollView>

            <!-- Logs tab -->
            <ScrollView android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0a0e12"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/positionTraceToggle"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:gravity="center" android:text="Start position trace"
                        android:textColor="#c8d6e0" android:background="@drawable/bg_card"
                        android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/positionTraceStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
                        android:text="Trace off" android:textColor="#8a9aaa" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Scanner diagnostics (scroll table horizontally)"
                        android:textColor="#ffffff" android:textSize="13sp" />
                    <HorizontalScrollView android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView android:id="@+id/diagnosticText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#4fd08a" android:textSize="11sp"
                            android:fontFamily="monospace" android:text="Diagnostics unavailable" />
                    </HorizontalScrollView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Application logs"
                        android:textColor="#ffffff" android:textSize="13sp" />
                    <TextView android:id="@+id/logText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#4fd08a" android:textSize="11sp"
                        android:fontFamily="monospace" android:text="Waiting for logs..." />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
